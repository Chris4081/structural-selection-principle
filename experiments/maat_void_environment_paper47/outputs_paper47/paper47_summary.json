    "eta_slip_env": "1 + beta_s * C_env",
    "Sigma_lens_env": "mu_env * (1 + eta_slip_env) / 2",
    "R_LG": "Sigma_lens_env / mu_env = (1 + eta_slip_env) / 2"
  },
